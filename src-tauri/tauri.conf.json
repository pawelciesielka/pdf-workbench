{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Workbench",
  "version": "0.3.2",
  "identifier": "eu.ciesielka.pdfworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Workbench",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": { "pdfium/pdfium.dll": "pdfium.dll", "pdfium/LICENSE-pdfium": "LICENSE-pdfium" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF", "description": "Dokument PDF", "role": "Viewer", "mimeType": "application/pdf" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Polish", "English"], "customLanguageFiles": { "Polish": "nsis/Polish.nsh" } }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMzlCQ0Q4OEQ4MEQ3MEUKUldRTzE0Q04yTHc1dnY4MzZKSmM0NTVabWcvdWhsc3dmZzhTMURWUDdXZk9JVDRkZ0pQUGJDMVMK",
      "endpoints": ["https://github.com/pawelciesielka/pdf-workbench/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
